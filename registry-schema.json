{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Biffo Plugin Registry Schema",
  "description": "Schema for plugins.json — the central plugin registry index.",
  "type": "object",
  "required": ["schema_version", "last_updated", "plugins"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"],
      "description": "Version of this registry schema."
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last registry update."
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "minor_version", "repo", "status"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Unique plugin slug."
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Full semver of latest release."
          },
          "minor_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$",
            "description": "Pinned minor version (e.g., '1.2')."
          },
          "repo": {
            "type": "string",
            "format": "uri",
            "description": "Clone URL of the plugin repository."
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "description": "Human-readable summary for the marketplace."
          },
          "author": {
            "type": "string",
            "default": "Biffo Team",
            "description": "Publisher name."
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Categorisation tags for filtering/search."
          },
          "required_core_version": {
            "type": "string",
            "default": ">=0.0.0",
            "description": "Minimum Biffo core version (npm-style range)."
          },
          "infra_modules": {
            "type": "array",
            "items": {
              "enum": ["compute", "storage", "events", "cdn", "database", "auth", "networking", "oidc", "api-gateway"]
            },
            "description": "Terraform module categories the plugin provisions."
          },
          "api_routes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Core API routes the plugin registers (for documentation)."
          },
          "ui_components": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Portal UI elements the plugin adds."
          },
          "status": {
            "type": "string",
            "enum": ["active", "disabled"],
            "default": "active",
            "description": "Whether the plugin is visible in the marketplace."
          }
        },
        "additionalProperties": false
      },
      "description": "List of available plugins."
    }
  },
  "additionalProperties": false
}